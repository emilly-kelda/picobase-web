# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_BASE_URL=
ENCRYPTION_KEY=

# Mercado Pago — platform account (src/lib/payments/mercadopago.ts)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Mercado Pago — marketplace OAuth (schools connect their own MP account;
# see src/app/api/auth/mercadopago/connect, .../callback/mercadopago,
# src/lib/payments/mercadopago-tenant.ts). NEXT_PUBLIC_MP_APP_ID and
# MP_CLIENT_SECRET come from the same app registration, not a second app —
# there is no separate "master access token" here, MERCADOPAGO_ACCESS_TOKEN
# above already is the platform account's token.
NEXT_PUBLIC_MP_APP_ID=
MP_CLIENT_SECRET=
NEXT_PUBLIC_MP_REDIRECT_URI=
